tests/fixtures/documents/*.pdf binary
tests/fixtures/documents/*.docx binary
tests/fixtures/documents/*.xlsx binary
tests/fixtures/documents/*.pptx binary
tests/fixtures/documents/*.csv -text whitespace=cr-at-eol
tests/fixtures/documents/*.txt -text whitespace=cr-at-eol
tests/fixtures/documents/invalid-utf8.txt binary
